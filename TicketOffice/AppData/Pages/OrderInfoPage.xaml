<Page x:Class="TicketOffice.AppData.Pages.OrderInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Language="ru-RU"
      Title="OrderInfoPage">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tbTitle" Grid.Row="0" Text="Заказ" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>

        <!--Данные заказа и оплаты-->
        <Grid Grid.Row="1" Background="#FEF3C7" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock x:Name="tbDate" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbStatus" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbUser" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbSum" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock x:Name="tbPayMethod" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbPayStatus" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbPayDate" FontSize="16" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Билеты в заказе" FontSize="16" Margin="10 8 10 3"/>

        <!--Двойное нажатие открывает билет-->
        <ListView x:Name="lvOrderTickets" Grid.Row="3" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="lvOrderTickets_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="brTicket" Background="White" BorderBrush="#78350F" BorderThickness="1" Margin="3" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Schedule.Events.image, TargetNullValue=/Images/poster.png, FallbackValue=/Images/poster.png}"
                                   Grid.Column="0"
                                   Width="90"
                                   Height="90"
                                   Margin="5"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="tbEvent" TextWrapping="Wrap" Margin="0 0 0 5" FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding Schedule.Events.nameEvent, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Категория:"/>
                                    <Run Text="{Binding Schedule.Events.CategoryEvents.categoryEvents1, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Дата:"/>
                                    <Run Text="{Binding Schedule.datetime, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Площадка:"/>
                                    <Run Text="{Binding Schedule.Halls.Plases.namePlace, Mode=OneWay}"/>
                                    <Run Text="| Зал:"/>
                                    <Run Text="{Binding Schedule.Halls.hall, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Ряд:"/>
                                    <Run Text="{Binding row_number, Mode=OneWay}"/>
                                    <Run Text="| Место:"/>
                                    <Run Text="{Binding seat_number, Mode=OneWay}"/>
                                    <Run Text="| Билет:"/>
                                    <Run Text="{Binding CategoryTickets.categoryTicket, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Статус:"/>
                                    <Run Text="{Binding TicketStatuses.ticketStatus, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock TextAlignment="Right" Foreground="Gray" TextDecorations="Strikethrough"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding oldPrice, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                    <Run Text="руб."/>
                                </TextBlock>
                                <TextBlock TextAlignment="Right" Foreground="Red"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="Скидка"/>
                                    <Run Text="{Binding discountPercent, StringFormat='{}{0}%', Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock x:Name="tbPrice" TextAlignment="Right" FontSize="18">
                                    <Run Text="{Binding NewPrice, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                    <Run Text="руб."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <!--Билеты дороже 1000 выделяются цветом и жирным шрифтом-->
                        <DataTrigger Binding="{Binding IsExpensive}" Value="True">
                            <Setter TargetName="brTicket" Property="Background" Value="#FDE68A"/>
                            <Setter TargetName="tbPrice" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="tbEvent" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnBack" Content="Назад" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>

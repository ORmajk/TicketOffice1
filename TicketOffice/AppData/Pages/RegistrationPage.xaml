<Page x:Class="TicketOffice.AppData.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="RegistrationPage">

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Background="#FEF3C7" Margin="10">
                <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>
                <TextBlock Text="ФИО" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <TextBox x:Name="tbFio" MaxLength="255" FontSize="16" Height="28" Margin="10 0 10 0"/>
                <TextBlock Text="Почта" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <TextBox x:Name="tbMail" MaxLength="255" FontSize="16" Height="28" Margin="10 0 10 0"/>
                <TextBlock Text="Телефон (+7XXXXXXXXXX)" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <TextBox x:Name="tbNumber" MaxLength="12" FontSize="16" Height="28" Margin="10 0 10 0"/>
                <TextBlock Text="Пароль (от 6 символов, буквы и цифры)" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <PasswordBox x:Name="pbPassword" MaxLength="50" FontSize="16" Height="28" Margin="10 0 10 0"/>
                <TextBlock Text="Повторите пароль" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <PasswordBox x:Name="pbPasswordRepeat" MaxLength="50" FontSize="16" Height="28" Margin="10 0 10 0"/>
                <Button x:Name="btnRegister" Content="Зарегистрироваться" Background="White" FontSize="16" Height="30" Margin="10 15 10 5" Click="btnRegister_Click"/>
                <Button x:Name="btnBack" Content="Назад ко входу" Background="White" FontSize="16" Height="30" Margin="10 5 10 15" Click="btnBack_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

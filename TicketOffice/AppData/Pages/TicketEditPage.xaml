<Page x:Class="TicketOffice.AppData.Pages.TicketEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      Title="TicketEditPage">

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Background="#FEF3C7" Margin="10">
                <TextBlock x:Name="tbTitle" Text="Новый билет" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>
                <Image Source="/Images/poster.png" Height="90" Width="90"/>

                <TextBlock Text="Название" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <TextBox x:Name="tbName" MaxLength="255" FontSize="16" Height="28" Margin="10 0 10 0"/>

                <TextBlock Text="Сеанс" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <ComboBox x:Name="cbSchedule" FontSize="16" Height="28" Margin="10 0 10 0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Events.nameEvent}"/>
                                <TextBlock Text="{Binding datetime, StringFormat=' - {0:dd.MM.yyyy HH:mm}'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Категория билета" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <ComboBox x:Name="cbCategory" DisplayMemberPath="categoryTicket" FontSize="16" Height="28" Margin="10 0 10 0"/>

                <TextBlock Text="Статус" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <ComboBox x:Name="cbStatus" DisplayMemberPath="ticketStatus" FontSize="16" Height="28" Margin="10 0 10 0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ряд" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                        <TextBox x:Name="tbRow" MaxLength="4" FontSize="16" Height="28" Margin="10 0 10 0"/>
                        <TextBlock Text="Старая цена" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                        <TextBox x:Name="tbOldPrice" MaxLength="10" FontSize="16" Height="28" Margin="10 0 10 0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Место" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                        <TextBox x:Name="tbSeat" MaxLength="4" FontSize="16" Height="28" Margin="10 0 10 0"/>
                        <TextBlock Text="Скидка, %" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                        <TextBox x:Name="tbDiscount" MaxLength="2" FontSize="16" Height="28" Margin="10 0 10 0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Цена (со скидкой считается сама)" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap"/>
                <TextBox x:Name="tbPrice" MaxLength="10" FontSize="16" Height="28" Margin="10 0 10 0"/>

                <Button x:Name="btnSaveChanges" Content="Сохранить" Background="White" FontSize="16" Height="30" Margin="10 15 10 5" Click="btnSaveChanges_Click"/>
                <Button x:Name="btnBack" Content="Назад" Background="White" FontSize="16" Height="30" Margin="10 5 10 15" Click="btnBack_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

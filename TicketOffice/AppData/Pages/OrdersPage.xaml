<Page x:Class="TicketOffice.AppData.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Language="ru-RU"
      Title="OrdersPage">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои заказы" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>

        <!--Список заказов, двойное нажатие открывает заказ-->
        <ListView x:Name="lvOrders" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="lvOrders_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="#78350F" BorderThickness="1" Margin="3" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="10 0 10 0">
                                <TextBlock TextWrapping="Wrap" Margin="0 0 0 5" FontSize="16" FontWeight="SemiBold">
                                    <Run Text="Заказ №"/><Run Text="{Binding id, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Дата:"/>
                                    <Run Text="{Binding dateOrder, StringFormat='{}{0:dd.MM.yyyy}', Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Статус:"/>
                                    <Run Text="{Binding OrderStatus.ticketStatuses, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Билетов:"/>
                                    <Run Text="{Binding OrderTickets.Count, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold">
                                <Run Text="{Binding sum, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                <Run Text="руб."/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Background="#FEF3C7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Нажмите на заказ два раза, чтобы открыть его" FontSize="14" VerticalAlignment="Center" Margin="10 0 10 0"/>
            <Button x:Name="btnBack" Grid.Column="1" Content="Назад" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnBack_Click"/>
        </Grid>
    </Grid>
</Page>

<Page x:Class="TicketOffice.AppData.Pages.TablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TablesPage">

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Таблицы" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>
        <TextBlock x:Name="tbTableName" Grid.Row="0" Grid.Column="1" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>

        <!--Меню таблиц-->
        <ListBox x:Name="lbTables" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" FontSize="14" Background="#FEF3C7" SelectionChanged="lbTables_SelectionChanged"/>

        <!--Данные выбранной таблицы-->
        <DataGrid x:Name="dgTable" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="True" CanUserDeleteRows="False" FontSize="14" Margin="5 0 5 0"
                  AutoGeneratingColumn="dgTable_AutoGeneratingColumn" InitializingNewItem="dgTable_InitializingNewItem"/>

        <WrapPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
            <Button x:Name="btnSaveChanges" Content="Сохранить изменения" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnSaveChanges_Click"/>
            <Button x:Name="btnDeleteRow" Content="Удалить запись" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnDeleteRow_Click"/>
            <Button x:Name="btnBack" Content="Назад" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>

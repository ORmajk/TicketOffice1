<Page x:Class="TicketOffice.AppData.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Background="#F8FAFC">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Background="#FEF3C7">
            <TextBlock Text="Главное меню" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>
            <TextBlock x:Name="tbHello" FontSize="16" Margin="10 8 10 3" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="tbRole" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="10 0 10 10"/>
            <Button x:Name="btnCatalog" Content="Каталог билетов" Background="White" FontSize="16" Height="30" Margin="10 5 10 5" Click="btnCatalog_Click"/>
            <Button x:Name="btnCart" Content="Корзина" Background="White" FontSize="16" Height="30" Margin="10 5 10 5" Click="btnCart_Click"/>
            <Button x:Name="btnOrders" Content="Мои заказы" Background="White" FontSize="16" Height="30" Margin="10 5 10 5" Click="btnOrders_Click"/>
            <Button x:Name="btnProfile" Content="Личный кабинет" Background="White" FontSize="16" Height="30" Margin="10 5 10 5" Click="btnProfile_Click"/>
            <Button x:Name="btnTables" Content="Таблицы базы данных" Background="White" FontSize="16" Height="30" Margin="10 5 10 5" Click="btnTables_Click"/>
            <Button x:Name="btnLogout" Content="Выйти" Background="White" FontSize="16" Height="30" Margin="10 5 10 15" Click="btnLogout_Click"/>
        </StackPanel>
    </Grid>
</Page>

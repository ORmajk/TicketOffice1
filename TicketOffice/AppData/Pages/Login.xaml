<Page x:Class="TicketOffice.AppData.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid Background="#F8FAFC">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="280" Width="250" Background="#FEF3C7">
            <TextBlock Text="Авторизация" TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10"/>
            <TextBlock Text="Номер/Почта" Margin="10 10 10 5" FontSize="18"/>
            <TextBox x:Name="tblogin" MaxLength="50" Margin="10 0 10 0" Height="25" FontSize="20"/>
            <TextBlock Text="Пароль" Margin="10 10 10 5" FontSize="18"/>
            <PasswordBox x:Name="pbPssword" MaxLength="50" Margin="10 0 10 0" Height="25" FontSize="20"/>
            <Button Content="Войти" Margin="10 15 10 0" Height="30" Background="White" FontSize="18" Click="Button_Click"/>
            <Button Content="Регистрация" Margin="10 15 10 0" Height="30" Background="White" FontSize="18" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Page>

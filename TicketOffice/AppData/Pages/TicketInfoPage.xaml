<Page x:Class="TicketOffice.AppData.Pages.TicketInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TicketOffice.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800"
      Title="TicketInfoPage">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о билете" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="#78350F" Margin="10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Background="#FEF3C7" Margin="10 0 10 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Афиша мероприятия (если фото нет, остается заглушка)-->
                <Image x:Name="imgPoster" Grid.Column="0" Source="/Images/poster.png" Height="180" Width="180" VerticalAlignment="Top" Margin="20"/>

                <StackPanel Grid.Column="1" Margin="10 20 20 20">
                    <TextBlock x:Name="tbEvent" FontSize="22" FontWeight="Bold" Foreground="#78350F" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbName" FontSize="16" TextWrapping="Wrap" Margin="0 0 0 10"/>

                    <TextBlock x:Name="tbCategoryEvent" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbOrganizer" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbDate" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbPlace" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbHall" FontSize="16" TextWrapping="Wrap" Margin="0 0 0 10"/>

                    <TextBlock x:Name="tbSeat" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbCategoryTicket" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbStatus" FontSize="16" TextWrapping="Wrap" Margin="0 0 0 10"/>

                    <TextBlock x:Name="tbOldPrice" FontSize="16" Foreground="Gray" TextDecorations="Strikethrough" Visibility="Collapsed"/>
                    <TextBlock x:Name="tbDiscount" FontSize="16" Foreground="Red" Visibility="Collapsed"/>
                    <TextBlock x:Name="tbPrice" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Background="#FEF3C7">
            <Button x:Name="btnAddToCart" Content="В корзину" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnAddToCart_Click"/>
            <Button x:Name="btnBack" Content="Назад" Background="White" FontSize="16" Height="30" Margin="5" Padding="10 0 10 0" Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>

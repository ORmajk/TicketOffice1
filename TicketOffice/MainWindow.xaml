<Window x:Class="TicketOffice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicketOffice"
        mc:Ignorable="d"
        Title="Билетер" Height="600" Width="1000" MinHeight="450" MinWidth="800" Icon="/icon.ico" WindowStartupLocation="CenterScreen">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Background="#FEF3C7" Orientation="Horizontal">
            <Image Source="/Images/logo.jpg" Height="50" Width="50" Margin="15 0 0 0"/>
            <TextBlock Text="Билетер" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#78350F" Margin="15 0 0 0"/>
        </StackPanel>

        <Frame x:Name="Frmain" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
